# ============================================================
# RestoMate AI - copy to .env and fill in real values
# ============================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=bremer

# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me_to_a_long_random_value
ACCESS_TOKEN_EXPIRE_MINUTES=480
KIOSK_SESSION_MINUTES=45

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
RATE_LIMIT_LOGIN_PER_MINUTE=10

# Optional OpenAI-compatible LLM. The kiosk works without it using the
# deterministic local language engine (no invented prices or menu items).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Paths are optional; defaults resolve inside the repository
# UPLOAD_DIR=C:/path/to/backend/uploads
# ML_ARTIFACT_DIR=C:/path/to/backend/ml_artifacts
