    USERS {
        int user_id PK
        varchar username UK
        varchar email UK
        varchar password_hash
        varchar password_algo
        enum role
        varchar pin_hash
        tinyint is_active
        datetime last_login_at
    }
    CUSTOMERS {
        int customer_id PK
        int user_id FK
        varchar customer_name
        varchar phone UK
        text address
    }
    USER_SESSIONS {
        char session_id PK
        int user_id FK
        char jwt_id UK
        datetime issued_at
        datetime expires_at
        datetime revoked_at
    }
    AUDIT_LOGS {
        bigint audit_id PK
        int user_id FK
        varchar action
        varchar entity_type
        varchar entity_id
        json details
        datetime created_at
    }
    CATEGORIES {
        int category_id PK
        varchar category_name
        varchar category_name_ar
        tinyint is_active
    }
    MENU_ITEMS {
        int item_id PK
        int category_id FK
        varchar item_name
        varchar item_name_ar
        text synonyms
        decimal price
        tinyint is_available
        tinyint is_featured
    }
    ORDERS {
        int order_id PK
        int customer_id FK
        datetime order_date
        enum status
        enum payment_status
        varchar payment_method FK
        enum order_source
        decimal total_amount
        varchar idempotency_key UK
    }
    ORDER_ITEMS {
        int order_item_id PK
        int order_id FK
        int item_id FK
        varchar item_name_snapshot
        int quantity
        decimal unit_price
    }
    ORDER_STATUS_HISTORY {
        bigint history_id PK
        int order_id FK
        enum previous_status
        enum new_status
        int changed_by FK
        datetime changed_at
    }
    ORDER_STOCK_APPLICATIONS {
        int order_id PK
        enum status
        datetime applied_at
        datetime reversed_at
    }
    PAYMENTS {
        bigint payment_id PK
        int order_id FK
        varchar payment_method FK
        enum payment_status
        decimal amount
        datetime paid_at
    }
    PAYMENT_METHODS {
        varchar code PK
        varchar name
        varchar name_ar
        tinyint is_active
    }
    SUPPLIERS {
        int supplier_id PK
        varchar supplier_name UK
        varchar phone
        varchar email
        tinyint is_active
    }
    INGREDIENTS {
        int ingredient_id PK
        varchar ingredient_name UK
        varchar ingredient_name_ar
        varchar unit_of_measure
        decimal minimum_stock
        decimal safety_stock
        int lead_time_days
        int default_supplier_id FK
    }
    INVENTORY_STOCK {
        bigint stock_id PK
        int ingredient_id FK_UK
        decimal quantity
        int updated_by FK
    }
    MENU_ITEM_INGREDIENTS {
        bigint menu_item_ingredient_id PK
        int item_id FK
        int ingredient_id FK
        decimal quantity
        varchar unit_of_measure
    }
    STOCK_MOVEMENTS {
        bigint movement_id PK
        int ingredient_id FK
        enum movement_type
        decimal quantity_change
        decimal quantity_after
        int order_id FK
        bigint purchase_order_id FK
        int user_id FK
    }
    PURCHASE_ORDERS {
        bigint purchase_order_id PK
        int supplier_id FK
        enum status
        date expected_date
        decimal total_amount
        int created_by FK
    }
    PURCHASE_ORDER_ITEMS {
        bigint purchase_order_item_id PK
        bigint purchase_order_id FK
        int ingredient_id FK
        decimal quantity_ordered
        decimal quantity_received
        decimal unit_cost
    }
    KIOSK_SESSIONS {
        char session_id PK
        enum status
        varchar state
        enum language
        datetime expires_at
        int order_id FK
    }
    KIOSK_CART_ITEMS {
        bigint cart_item_id PK
        char session_id FK
        int item_id FK
        int quantity
    }
    KIOSK_MESSAGES {
        bigint message_id PK
        char session_id FK
        enum role
        text content
        enum language
    }
    ITEM_ALIASES {
        int alias_id PK
        int item_id FK
        varchar alias
    }
    RESTAURANT_TABLES {
        int table_id PK
        int table_number UK
        tinyint is_active
    }
    SCHEMA_MIGRATIONS {
        varchar version PK
        datetime applied_at
        char checksum
    }
